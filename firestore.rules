rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper functions
    // ============================================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Get current timestamp
    function now() {
      return request.time;
    }
    
    // Check author field (supports both English and Spanish field names)
    function isAuthor(data) {
      return data.authorId == request.auth.uid || data.id_autor == request.auth.uid;
    }

    // ============================================================
    // Users Collection: /users/{userId}
    // ============================================================
    match /users/{userId} {
      // Anyone can read user profiles (for showing author names, etc.)
      allow read: if true;
      
      // Users can only create/update their own profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      
      // Users can only delete their own profile
      allow delete: if isOwner(userId);
    }

    // ============================================================
    // Posts Collection: /posts/{postId}
    // Supports both English (authorId) and Spanish (id_autor) field names
    // ============================================================
    match /posts/{postId} {
      // Anyone can read posts
      allow read: if true;
      
      // Authenticated users can create posts
      // Post must have authorId or id_autor matching auth.uid
      allow create: if isAuthenticated() 
        && isAuthor(request.resource.data);
      
      // Only the author can update or delete their post
      allow update: if isAuthenticated() 
        && isAuthor(resource.data);
      allow delete: if isAuthenticated() 
        && isAuthor(resource.data);

      // ============================================================
      // Comments Subcollection: /posts/{postId}/comments/{commentId}
      // Supports both English (authorId) and Spanish (id_autor) field names
      // ============================================================
      match /comments/{commentId} {
        // Anyone can read comments
        allow read: if true;
        
        // Authenticated users can create comments
        // Comment must have authorId or id_autor matching auth.uid
        allow create: if isAuthenticated() 
          && isAuthor(request.resource.data);
        
        // Only the author can update or delete their comment
        allow update: if isAuthenticated() 
          && isAuthor(resource.data);
        allow delete: if isAuthenticated() 
          && isAuthor(resource.data);
      }

      // ============================================================
      // Likes Subcollection: /posts/{postId}/likes/{userId}
      // Document ID must be auth.uid
      // Supports both English (userId) and Spanish (id_usuario) field names
      // ============================================================
      match /likes/{likeUserId} {
        // Anyone can read likes
        allow read: if true;
        
        // Users can only create likes with their own uid as doc ID
        // Like document must have userId or id_usuario matching auth.uid
        allow create: if isAuthenticated() 
          && likeUserId == request.auth.uid
          && (request.resource.data.userId == request.auth.uid 
              || request.resource.data.id_usuario == request.auth.uid);
        
        // Users can only delete their own likes
        allow delete: if isAuthenticated() 
          && likeUserId == request.auth.uid;
        
        // Likes cannot be updated
        allow update: if false;
      }
    }

    // ============================================================
    // Legacy collections (for backward compatibility during migration)
    // These can be removed once migration is complete
    // ============================================================
    
    // Legacy comments collection: /comments/{commentId}
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() 
        && isAuthor(request.resource.data);
      allow update: if isAuthenticated() 
        && isAuthor(resource.data);
      allow delete: if isAuthenticated() 
        && isAuthor(resource.data);
    }

    // Legacy likes collection: /likes/{likeId}
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() 
        && (request.resource.data.userId == request.auth.uid 
            || request.resource.data.id_usuario == request.auth.uid);
      allow delete: if isAuthenticated() 
        && (resource.data.userId == request.auth.uid 
            || resource.data.id_usuario == request.auth.uid);
    }

    // Saved posts collection: /saved_posts/{savedPostId}
    match /saved_posts/{savedPostId} {
      allow read: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
    }
  }
}
